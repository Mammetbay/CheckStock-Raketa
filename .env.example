# CheckStock — Пример конфигурации окружения (.env.example)
# Скопируйте файл в .env при необходимости: cp .env.example .env

# 1. Подключение к PostgreSQL 16 (используется в Docker Compose и продакшене):
DATABASE_URL=postgresql+psycopg://checkstock:checkstock@localhost:5432/checkstock

# 2. Локальный запуск без Docker (используется по умолчанию, если DATABASE_URL не задан):
# DATABASE_URL=sqlite:///./checkstock.db

# Параметры контейнера PostgreSQL (для docker-compose.yml):
POSTGRES_USER=checkstock
POSTGRES_PASSWORD=checkstock
POSTGRES_DB=checkstock
